---
// The home page, benefits first: the hero (three measured numbers and where they were measured, and a recorded
// decision), teaching one task end to end, the threshold line on that task's certificates, the use cases, the one
// Good fit box, the public board's one dated result, Get started and the closing. Every comparison with another
// system is on Benchmarks, dated, except the board's result here.
import Closing from '../components/home/Closing.astro';
import GetStarted from '../components/home/GetStarted.astro';
import GoodFit from '../components/home/GoodFit.astro';
import HomeDemo from '../components/home/HomeDemo.astro';
import Proof from '../components/home/Proof.astro';
import TeachIt from '../components/home/TeachIt.astro';
import Threshold from '../components/home/Threshold.astro';
import UseCases from '../components/home/UseCases.astro';
import { site } from '../config/site';
import SiteLayout from '../layouts/SiteLayout.astro';
import { oneSentence } from '../lib/home.mjs';
import { heroStats } from '../lib/home-page.mjs';
import '../styles/home.css';
import { pin } from '../lib/upstream.mjs';

const hero = heroStats();
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareSourceCode',
	name: site.name,
	description: oneSentence(),
	url: site.url,
	codeRepository: site.repository,
	programmingLanguage: 'Python',
	license: 'https://www.apache.org/licenses/LICENSE-2.0',
	version: pin.tag.replace(/^v/, ''),
};
---
<SiteLayout bodyClass="home" title={`${site.name}: decisions you can trust, on your own hardware`} description={oneSentence()} jsonLd={jsonLd}>
	<section class="hero">
		<div class="hero__glow" aria-hidden="true"></div>
		<div class="wrap hero__grid">
			<div class="hero__copy">
				<a class="pill" href="/docs/releases/"><b>{pin.tag}</b> Release notes</a>
				<h1>Decisions you can trust, on <em class="hl">your own hardware</em>. Open source.</h1>
				<p class="lede">Send a text and a question with its options. Get back a <a class="gloss" href="/docs/glossary/#probability">probability</a> for every option, in one call. Teach it your task, and it certifies which answers to trust.</p>
				<ul class="chips" data-launch="stats">
					{hero.stats.map((s) => <li class="chip2"><b>{s.n}</b> {s.l}</li>)}
				</ul>
				<p class="hero__cond">{hero.conditions} <a href="/benchmarks/#many-questions">How these were measured</a>.</p>
				<div class="actions hero__try">
					<a class="button button--primary" href="/docs/">Get started</a>
					<a class="button" href="/docs/use-cases/">See use cases</a>
					<a class="button" href={site.repository}>GitHub</a>
				</div>
			</div>
			<HomeDemo />
		</div>
	</section>

	<TeachIt />

	<Threshold />

	<UseCases />

	<GoodFit />

	<Proof />

	<GetStarted />

	<Closing />
	<script>
		import '../scripts/home.ts';
	</script>
</SiteLayout>
