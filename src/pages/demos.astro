---
// The demos page, in round 6's system: a short intro, then each demo as a card with its clip (chips for each scene
// and base, the default base first), one line on how its decisions are judged, three key numbers of the default base
// as tiles, and every player's results, Decisio's errors and the method in disclosures. Everything is read from
// docs/demos/README.md at the pinned release (src/lib/demos.mjs); the hosted players' own clips stay on GitHub.
import Clip from '../components/home/Clip.astro';
import PageHero from '../components/PageHero.astro';
import UpstreamTable from '../components/UpstreamTable.astro';
import { baseOfName, colourOf } from '../config/bases.mjs';
import { site } from '../config/site';
import SiteLayout from '../layouts/SiteLayout.astro';
import { demoCards, intro, sectionParts, watchNote } from '../lib/demos.mjs';
import { breadcrumbs } from '../lib/jsonld.mjs';
import { pin } from '../lib/upstream.mjs';

const cards = demoCards();
const hostedClips = `${site.repository}/blob/${pin.tag}/docs/demos/README.md#watch-it-play`;
const examples = `${site.repository}/tree/${pin.tag}/examples/demos`;
const baseOf = (player: string) => baseOfName(player.replace(/ base$/, ''));
const DEFAULT = 'gemma-4-31b';
const [, ...setup] = intro();
const classed = sectionParts('How each decision is judged').filter((b) => b.kind !== 'table');
const teaching = sectionParts('Teaching');
const reproducing = sectionParts('Reproducing');
const plain = (html: string) => html.replace(/<[^>]+>/g, '');
// What a demo's table counts ("8 players", "3 bases") and the detail its heading gives in brackets.
const counted = (d: (typeof cards)[number]) => {
	const t = d.results.blocks.find((b: any) => b.kind === 'table') as { head: string[]; rows: string[][] };
	return { n: t.rows.length, noun: plain(t.head[0]).toLowerCase(), detail: /\(([^)]*)\)/.exec(d.results.heading)?.[1] ?? '' };
};
---
<SiteLayout bodyClass="home" jsonLd={breadcrumbs([{ name: 'Demos', path: '/demos/' }])} title={`Demos: ${site.name}`} description="Pong, a driving simulator, a browser agent and ticket triage on each base, every decision checked against an oracle.">
	<PageHero
		label="Demos"
		lede="Decisio played Pong, drove a simulator, ran a browser agent and triaged support tickets on each of its three bases. An oracle checked every decision it made."
		links={[{ href: '/docs/demos/', text: 'The full write-up' }, { href: hostedClips, text: "The hosted players' clips" }, { href: examples, text: 'Run them yourself' }]}
	>Four demos, <em class="hl">every decision judged</em></PageHero>

	<section class="section psec" aria-labelledby="watch">
		<div class="wrap">
			<div class="section__head">
				<p class="kicker">Watch it play</p>
				<h2 id="watch">Recorded runs, <em class="hl">replayed</em></h2>
				<p set:html={watchNote('Every clip is rendered')} />
				<p>Each card opens on the default base, Gemma 4 31B, and its numbers are that base's. Cygnet and four hosted models played the same seeds; their results are in each card's table.</p>
			</div>

			{cards.map((card) => ({ ...card, counted: counted(card) })).map((d) => (
				<article class="demo-card tile" id={d.key} aria-labelledby={`${d.key}-h`} data-demo data-reveal>
					<div class="demo-card__media">
						{d.scenes.length > 1 && (
							<div class="demo-card__takes" role="group" aria-label={`${d.title}: scene`} data-takes="scene" hidden>
								{d.scenes.map((s, i) => <button class="chip" type="button" aria-pressed={String(i === 0)} data-scene={i}>{s.label}</button>)}
							</div>
						)}
						{d.scenes.some((s) => s.clips.length > 1) && (
							<div class="demo-card__takes" role="group" aria-label={`${d.title}: base`} data-takes="base" hidden>
								{d.scenes.find((s) => s.clips.length > 1)!.clips.map((c) => (
									<button class:list={['chip', colourOf(baseOf(c.player)!)]} type="button" aria-pressed={String(baseOf(c.player) === DEFAULT)} data-base={baseOf(c.player)}>
										<span class="dot" aria-hidden="true"></span>{c.player.replace(/ base$/, '')}
									</button>
								))}
							</div>
						)}
						{d.scenes.flatMap((s, i) => s.clips.map((c) => (
							<div class="demo-card__take" data-scene={i} data-base={s.clips.length > 1 ? baseOf(c.player) : ''}>
								<Clip name={c.name} caption={s.clips.length > 1 ? `${s.caption}: ${c.player}` : s.caption} base={s.clips.length > 1 ? colourOf(baseOf(c.player)!) : undefined} />
							</div>
						)))}
					</div>
					<div class="demo-card__text">
						<h2 class="demo-card__title" id={`${d.key}-h`}>{d.title}</h2>
						<p class="demo-card__line">{d.line}</p>
						<ul class="minis" data-table-keys>
							{d.minis.map((m) => <li class="mini"><span class="mini__n">{m.n}</span><span class="mini__l">{m.l}</span></li>)}
						</ul>
						<p class="demo-card__meta">Gemma 4 31B, decisio {d.version}, {d.date}</p>
					</div>

					<details class="disc">
						<summary>Every {d.counted.noun} <span class="disc__n">{d.counted.n} {d.counted.noun}s{d.counted.detail ? `, ${d.counted.detail}` : ''}</span></summary>
						<div class="disc__body">
							{d.results.blocks.map((b: any) =>
								b.kind === 'table' ? (
									<UpstreamTable head={b.head} rows={b.rows} numeric={!/^row$/.test(b.head[0])} caption={d.results.heading} />
								) : b.kind === 'p' ? (
									<div data-table-notes>{b.parts.map((h: string) => <p set:html={h} />)}</div>
								) : (
									<ul class="result__list" data-table-notes>{b.items.map((i: string) => <li set:html={i} />)}</ul>
								),
							)}
						</div>
					</details>
					{d.errors && (
						<details class="disc">
							<summary>Where Decisio was wrong</summary>
							<div class="disc__body">
								<UpstreamTable head={d.errors.head} rows={d.errors.rows} numeric={false} caption={`${d.title}: Decisio's errors, by kind`} />
								{d.errors.notes.length > 0 && <div data-table-notes>{d.errors.notes.map((h) => <p set:html={h} />)}</div>}
							</div>
						</details>
					)}
					<details class="disc">
						<summary>How it was judged</summary>
						<div class="disc__body">
							<dl class="demo-card__oracle">
								<dt>{plain(d.oracle.head[1]).replace(/^the /, 'The ')}</dt>
								<dd set:html={d.oracle.row[1]} />
								<dt>{plain(d.oracle.head[2]).replace(/^what/, 'What')}</dt>
								<dd set:html={d.oracle.row[2]} />
							</dl>
							{d.renderings && d.renderings.rows.length > 0 && (
								<>
									<h3>Renderings tested on held-out data</h3>
									<UpstreamTable head={d.renderings.head} rows={d.renderings.rows} numeric={false} caption={`${d.title}: renderings tested on held-out data`} />
									<div data-table-notes>{d.renderings.notes.map((h) => <p set:html={h} />)}</div>
								</>
							)}
							{d.key === 'pong' && <p><a href="/docs/demos/#pongs-limit">Pong's limit</a>, in the full write-up, is what the default question asks of the model and why the larger base answers it better.</p>}
							{d.key === 'triage' && (<><h3>Teaching</h3><div data-table-notes>{teaching.map((b) => b.kind === 'p' && <p set:html={b.html} />)}</div></>)}
						</div>
					</details>
				</article>
			))}
		</div>
	</section>

	<section class="section psec" aria-labelledby="method">
		<div class="wrap">
			<div class="section__head">
				<p class="kicker">Method</p>
				<h2 id="method">How the demos <em class="hl">were run</em></h2>
				<p>The same seeds, oracles and renderings for every base, in one session on one card. <a href="/docs/demos/">The full write-up</a> has every table as it was written.</p>
			</div>
			<div class="pcard tile" data-reveal>
				<details class="disc">
					<summary>The setup</summary>
					<div class="disc__body">{setup.flat().map((h) => <p set:html={h} />)}</div>
				</details>
				<details class="disc">
					<summary>How a disagreement is classed</summary>
					<div class="disc__body">
						{classed.map((b: any) => (b.kind === 'p' ? <p set:html={b.html} /> : b.kind === 'ol' ? <ol>{b.items.map((i: string) => <li set:html={i} />)}</ol> : <ul>{b.items.map((i: string) => <li set:html={i} />)}</ul>))}
					</div>
				</details>
				<details class="disc">
					<summary>Reproducing</summary>
					<div class="disc__body">{reproducing.map((b: any) => b.kind === 'p' && <p set:html={b.html} />)}</div>
				</details>
			</div>
		</div>
	</section>
</SiteLayout>
<script>
	import '../scripts/reveal.ts';
	import '../scripts/demos.ts';
</script>
