---
// The benchmarks page: what decisio does, measured and dated, in six short sections. Four static tiles; many questions
// about one document (the same-session chart); choosing a base (the README's table, one line per base, the paired
// bases in a disclosure); confidence (the calibration error per base); the public boards (JevBench and the Decision
// Index); and beside a hosted service and open entries (the comparison of 2026-10-05, the recorded demos' players),
// then what next. Every figure is from launch_facts.public.json or the pinned decisio release with its record and its
// date; this is the one page that sets decisio beside other systems, with no rank (decided 2026-10-15).
import BenchmarkTable from '../components/BenchmarkTable.astro';
import ConfidenceChart from '../components/ConfidenceChart.astro';
import HowItCompares from '../components/HowItCompares.astro';
import JevbenchSection from '../components/JevbenchSection.astro';
import ManyQuestions from '../components/ManyQuestions.astro';
import PageHero from '../components/PageHero.astro';
import Source from '../components/Source.astro';
import UpstreamTable from '../components/UpstreamTable.astro';
import { colourOf } from '../config/bases.mjs';
import { site } from '../config/site';
import SiteLayout from '../layouts/SiteLayout.astro';
import { baseLines, benchTiles, demoPlayers, runOf, tableConditions, tableNotes } from '../lib/bench-page.mjs';
import { breadcrumbs } from '../lib/jsonld.mjs';
import { BOARD_URL, decisionIndexBoard } from '../lib/launch.mjs';
import { paragraphStarting, table } from '../lib/upstream-content.mjs';

const { tiles } = benchTiles();
const di = decisionIndexBoard();
const paired = table('README.md', 'Choosing a base', 2);
// The paired table's own opening sentence; the README's next sentences repeat figures the page already shows.
const pairedIntro = paragraphStarting('README.md', 'Choosing a base', 'What drives the choice').split('\n')[0];
const lines = baseLines();
const notes = tableNotes();
const measured = tableConditions();
const players = demoPlayers();
const KEY: Record<string, string> = { g31: 'gemma-4-31b', g12: 'gemma-4-12b', qwen: 'qwen3.6-35b-a3b' };
const sections = [
	['many-questions', 'Many questions'],
	['bases', 'Choosing a base'],
	['confidence', 'Confidence'],
	['jevbench', 'JevBench'],
	['decision-index', 'Decision Index'],
	['compares', 'Beside other systems'],
];
const title = `Benchmarks: ${site.name}`;
const description = 'What decisio does, measured and dated: many questions about one document, each base, the calibration error, two public boards, and decisio beside a hosted service and open entries.';
---
<SiteLayout bodyClass="home" jsonLd={breadcrumbs([{ name: 'Benchmarks', path: '/benchmarks/' }])} title={title} description={description}>
	<PageHero
		label="Benchmarks"
		lede="Ask 50 questions about one document and get every answer in about a second, on one card you own. Every number below is a measurement, with its date and its source."
		links={[{ href: '/docs/evaluation-card/', text: 'Evaluation card' }, { href: BOARD_URL, text: 'JevBench live board' }, { href: di.link, text: 'Decision Index board' }]}
	>What it does, <em class="hl">measured and dated</em></PageHero>

	<section class="section psec bench-top" aria-label="At a glance">
		<div class="wrap">
			<ul class="pnav" aria-label="On this page">
				<li class="pnav__label" aria-hidden="true">On this page</li>
				{sections.map(([id, name]) => <li><a class="chip" href={`#${id}`}>{name}</a></li>)}
			</ul>
			<ul class="cards3 bench-tiles mt-6" data-launch="bench-tiles" data-table-keys>
				{tiles.map((t, i) => (
					<li class:list={['card3', 'tile', { 'tile--active': i === 0 }]}>
						<span class="card3__n">{t.n}</span>
						<span class="card3__l">{t.text}</span>
						<span class="card3__d src-note"><a href={t.href}>{t.date}</a></span>
					</li>
				))}
			</ul>
		</div>
	</section>

	<section class="section psec" aria-labelledby="many-questions">
		<div class="wrap">
			<div class="pcard tile mq-card">
				<ManyQuestions />
			</div>
		</div>
	</section>

	<section class="section psec" aria-labelledby="bases">
		<div class="wrap">
			<div class="section__head">
				<p class="kicker">Each base</p>
				<h2 id="bases">Choosing a <em class="hl">base</em></h2>
				<p>Three models serve the same API. Each was measured by us with the public harnesses, and none of these is a board score. <a href="/docs/bases/">Choosing a model</a> says how to pick and start each one.</p>
			</div>
			<ul class="bases">
				{lines.map((l) => <li class:list={['bases__i', colourOf(KEY[l.base])]}><span class="dot" aria-hidden="true"></span><b>{l.name}</b>: {l.text}</li>)}
			</ul>
			<div class="pcard tile">
				<div class="pcard__head">
					<h3 class="pcard__title">Accuracy and time, each base</h3>
					<p class="pcard__meta">each base with its own defaults on {measured.label}; higher is better, but for the times; each column links to its record</p>
				</div>
				<BenchmarkTable />
				<div class="pcard__foot" data-table-notes>{notes.map((n) => <p class:list={{ 'src-note': n.source }}>{n.text}</p>)}</div>
				<details class="disc">
					<summary>Gemma 4 12B and Qwen3.6-35B-A3B on the same items, with JevBench v1.5, {runOf('gemma-4-12b')}</summary>
					<div class="disc__body">
						<p set:html={pairedIntro} />
						<UpstreamTable head={paired.head} rows={paired.rows} caption="Gemma 4 12B against Qwen3.6-35B-A3B on the same items" />
						<p class="small"><Source record="runs/2026-10-04_gemma-base/" /></p>
					</div>
				</details>
			</div>
		</div>
	</section>

	<section class="section psec" aria-labelledby="confidence">
		<div class="wrap">
			<div class="section__head">
				<p class="kicker">Confidence</p>
				<h2 id="confidence">Probabilities that <em class="hl">mean what they say</em></h2>
				<p>The <a class="gloss" href="/docs/glossary/#calibration-error">calibration error</a> is the average gap between the probability an answer states and how often answers like it were right: lower is better, and zero would be exact. Here it is on JevBench's published items, on its standard and hard tiers.</p>
			</div>
			<div class="pcard tile">
				<ConfidenceChart />
				<p class="pcard__foot">Measured by us on {measured.label}, with JevBench's own measure, over ten equal-width bins of the probability; <a href="/docs/evaluation-card/#3-numbers">the evaluation card, section 3</a>, has every calibration table and what was fitted on what.</p>
			</div>
		</div>
	</section>

	<JevbenchSection />

	<section class="section psec" aria-labelledby="decision-index">
		<div class="wrap">
			<div class="section__head">
				<p class="kicker">Public boards</p>
				<h2 id="decision-index">The Decision Index <em class="hl">board</em></h2>
				<p>The Decision Index runs 38 public benchmarks in five areas and scores each system from 0 to 100. Its board lists decisio's rows from our submissions, in <a href={di.link}>its data file of {di.date}</a>.</p>
			</div>
			<div class="pcard tile">
				<div class="pcard__head">
					<h3 class="pcard__title">decisio's rows on the board</h3>
					<p class="pcard__meta"><a href={di.link}>{di.version}, the board's data file of {di.date}</a></p>
				</div>
				<div class="table-scroll" tabindex="0" role="region" aria-label="decisio's rows on the Decision Index board">
					<table class="data-table data-table--stack">
						<caption class="sr-only">decisio's rows as the Decision Index board lists them, {di.version}, its data file of {di.date}</caption>
						<thead>
							<tr><th scope="col">Row</th><th scope="col" class="num">Public index</th><th scope="col" class="num">Edition 0.3 index</th></tr>
						</thead>
						<tbody>
							{di.rows.map((r) => (
								<tr class:list={{ 'row--ours': r === di.ours }}>
									<th scope="row">{r.name}</th>
									<td class="num" data-label="Public index"><span>{r.pub.toFixed(2)}</span></td>
									<td class="num" data-label="Edition 0.3 index"><span>{r.v03.toFixed(2)}</span></td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
				<p class="pcard__foot src-note">The rows as the board lists them: {di.rows.map((r) => `${r.name.replace(/^Decisio, /, '')} on decisio ${r.release}`).join('; ')}.</p>
				<p class="pcard__foot"><a href="/docs/evaluation-card/#8-the-decision-indexs-whole-suite-self-run">The evaluation card, section 8</a>, has our own runs of the whole suite.</p>
			</div>
		</div>
	</section>

	<section class="section psec" aria-labelledby="compares">
		<div class="wrap">
			<div class="section__head">
				<p class="kicker">Beside other systems</p>
				<h2 id="compares">Beside a hosted service <em class="hl">and open entries</em></h2>
				<p>decisio's three bases beside TypeSafe's Jev 1.13 and three open-weights entries from the Decision Index's public board, as of 2026-10-05. Jev's and the other entries' values come only from the public boards and TypeSafe's public documentation; decisio's are our own runs on the Decision Index 0.2.1.</p>
			</div>
			<HowItCompares />

			<div class="pcard tile">
				<div class="pcard__head">
					<h3 class="pcard__title" id="compares-demos">The recorded demos, every player</h3>
					<p class="pcard__meta">the same games, seeds and checks for every player, on {players.dates.join(' and ')}</p>
				</div>
				<p class="pcard__foot">The <a href="/demos/">Demos</a> page shows decisio's own runs; here are the other players beside them.</p>
				<details class="disc">
					<summary>The players <span class="disc__n">{players.rows.length} rows</span></summary>
					<div class="disc__body"><UpstreamTable head={players.head} rows={players.rows} numeric={false} caption="The players of the recorded demos, with their models, dates and routes" /></div>
				</details>
				{players.games.map((g) => (
					<details class="disc">
						<summary>{g.name} <span class="disc__n">{g.table.rows.length} rows</span></summary>
						<div class="disc__body"><UpstreamTable head={g.table.head} rows={g.table.rows} caption={g.name} /></div>
					</details>
				))}
			</div>
		</div>
	</section>

	<section class="section psec" aria-labelledby="next">
		<div class="wrap">
			<div class="section__head">
				<p class="kicker">What next</p>
				<h2 id="next">Before you rely on <em class="hl">a number</em></h2>
			</div>
			<ul class="plain-list bench-next">
				<li>Each figure is one card, one run: your card, host and load will move the times.</li>
				<li>Every time on this page is server time, one request at a time; <a href="/docs/scale/">Scale</a> covers a busy server.</li>
				<li>Several figures were measured on earlier releases of the same models; each says which.</li>
				<li>Every decisio figure here was measured on the plain layout, the text then the question; the Gemma models now serve the header layout by default, which answered more accurately on most of what was measured (<a href="/docs/layout/">Choose the prompt layout</a>).</li>
			</ul>
			<p class="page-hero__links"><a class="chip" href="/docs/evaluation-card/">The evaluation card</a><a class="chip" href="/docs/limits/">Requirements and limits</a><a class="chip" href="/docs/bases/">Choosing a model</a></p>
		</div>
	</section>
</SiteLayout>
<script>
	import '../scripts/disclose.ts';
</script>
