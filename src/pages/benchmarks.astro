---
// The benchmarks page, in round 6's system: four dated tiles from the launch facts' stable claims, then the public boards
// (JevBench's charts, alphabetical and dated, and the rows the Decision Index board lists), each base's own measurements,
// server time, the paired bases, many questions about one document, how it compares, and the limits. Every figure
// is from launch_facts.public.json or the pinned decisio release with its record; tables sit in cards and method text in
// disclosures; no paragraph runs past three sentences and nothing ranks (decided 2026-10-15).
import BenchmarkTable from '../components/BenchmarkTable.astro';
import HowItCompares from '../components/HowItCompares.astro';
import JevbenchSection from '../components/JevbenchSection.astro';
import ManyQuestions from '../components/ManyQuestions.astro';
import PageHero from '../components/PageHero.astro';
import Source from '../components/Source.astro';
import SpeedCharts from '../components/SpeedCharts.astro';
import UpstreamTable from '../components/UpstreamTable.astro';
import { site } from '../config/site';
import SiteLayout from '../layouts/SiteLayout.astro';
import { withoutRepeats } from '../lib/figures.mjs';
import { benchmarks } from '../lib/home.mjs';
import { breadcrumbs } from '../lib/jsonld.mjs';
import { BOARD_URL, benchStats, decisionIndexBoard } from '../lib/launch.mjs';
import { findHeading, listItemParts, listItems, paragraphStarting, sectionBlocks, table } from '../lib/upstream-content.mjs';

const b = benchmarks();
const tiles = benchStats();
const di = decisionIndexBoard();
const paired = table('README.md', 'Choosing a base', 2);
// The paired table's own opening sentence; the README's next sentences repeat figures the page already shows.
const pairedIntro = paragraphStarting('README.md', 'Choosing a base', 'What drives the choice').split('\n')[0];
const thirdBase = paragraphStarting('README.md', 'Choosing a base', 'Gemma 4 31B was measured in its own session').split('\n')[1];
const limits = listItems('EVAL_CARD.md', '5. Limits');
// The README's server-time rows (the pinned release may carry none; its times are then rows of the accuracy table)
// and its note on where they were measured, less what the limits below already state.
const latency = withoutRepeats(b.latency, limits);
// The release's own runs of the Decision Index's whole suite (EVAL_CARD section 8), before the board took them in.
const selfRunHeading = findHeading('EVAL_CARD.md', /Decision Index's whole suite, self-run/);
const selfRunTables = selfRunHeading ? sectionBlocks('EVAL_CARD.md', selfRunHeading).filter((x) => x.kind === 'table') : [];
const anchor = (h: string) => h.toLowerCase().replace(/[^a-z0-9 -]/g, '').trim().replace(/ /g, '-');
// A limit is a bold title and its sentences; as a tile, the title is its heading and the sentences at most three to a
// paragraph.
const limitTiles = listItemParts('EVAL_CARD.md', '5. Limits').map(([first, ...rest]) => {
	const m = /^<strong>([^<]+?)\.?<\/strong>\s*(.*)$/s.exec(first);
	return m ? { title: m[1], body: [m[2], ...rest].filter(Boolean) } : { title: '', body: [first, ...rest] };
});
const sections = [
	['jevbench', 'JevBench'],
	['decision-index', 'Decision Index'],
	['bases', 'Each base'],
	...(b.speed.length > 0 ? [['speed', 'Server time']] : []),
	['paired', 'Paired bases'],
	['many-questions', 'Many questions'],
	['compares', 'How it compares'],
	['limits', 'Limits'],
];
const title = `Benchmarks: ${site.name}`;
const description = 'What each base measured on the public harnesses and on two public boards, every figure dated and linked to its record, beside Jev and three open entries with their intervals.';
---
<SiteLayout bodyClass="home" jsonLd={breadcrumbs([{ name: 'Benchmarks', path: '/benchmarks/' }])} title={title} description={description}>
	<PageHero
		label="Benchmarks"
		lede="Each base measured on the public harnesses and read by two public boards. Every figure carries its date and links to its record."
		links={[{ href: BOARD_URL, text: 'JevBench live board' }, { href: di.link, text: 'Decision Index board' }, { href: '/docs/evaluation-card/', text: 'Evaluation card' }]}
	>What was <em class="hl">measured</em>, and when</PageHero>

	<section class="section psec bench-top" aria-label="At a glance">
		<div class="wrap">
			<ul class="pnav" aria-label="On this page">
				<li class="pnav__label" aria-hidden="true">On this page</li>
				{sections.map(([id, name]) => <li><a class="chip" href={`#${id}`}>{name}</a></li>)}
			</ul>
			<ul class="cards3 bench-tiles mt-6" data-launch="bench-tiles" data-table-keys data-reveal>
				{tiles.map((t, i) => (
					<li class:list={['card3', 'tile', 'tilt', { 'tile--active': i === 0 }]}>
						<span class="card3__n"><span class="count" data-to={t.n} data-dec={t.dec} data-final={t.final}>{t.final}</span>{t.suffix}</span>
						<span class="card3__l">{t.text}</span>
						<span class="card3__d"><a href={t.href}>{t.date.replace(/\d{4}-\d{2}-\d{2}$/, '')}<span class="nowrap">{/\d{4}-\d{2}-\d{2}$/.exec(t.date)?.[0]}</span></a></span>
					</li>
				))}
			</ul>
		</div>
	</section>

	<JevbenchSection />

	<section class="section psec" aria-labelledby="decision-index">
		<div class="wrap">
			<div class="section__head">
				<p class="kicker">Decision Index</p>
				<h2 id="decision-index">The Decision Index <em class="hl">board</em></h2>
				<p data-table-notes>{di.text} The rows come from our submissions, {di.prs.map((p, i) => <>{i > 0 && ' and '}<a href={p.url}>{p.name}</a></>)}: both are closed and not merged on GitHub, and the maintainer took the rows into <a href={di.link}>the board's data file</a>.</p>
			</div>
			<div class="pcard tile" data-reveal>
				<div class="pcard__head">
					<h3 class="pcard__title">decisio's rows on the board</h3>
					<p class="pcard__meta"><a href={di.link}>{di.version}, the board's data file of {di.date}</a></p>
				</div>
				<div class="table-scroll" tabindex="0" role="region" aria-label="decisio's rows on the Decision Index board">
					<table class="data-table data-table--stack">
						<caption class="sr-only">decisio's rows as the Decision Index board lists them, {di.version}, its data file of {di.date}</caption>
						<thead>
							<tr><th scope="col">Row</th><th scope="col" class="num">Public index</th><th scope="col" class="num">Edition 0.3 index</th></tr>
						</thead>
						<tbody>
							{di.rows.map((r) => (
								<tr class:list={{ 'row--ours': r === di.ours }}>
									<th scope="row">{r.name}</th>
									<td class="num" data-label="Public index"><span>{r.pub.toFixed(2)}</span></td>
									<td class="num" data-label="Edition 0.3 index"><span>{r.v03.toFixed(2)}</span></td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
				{selfRunTables.length > 0 && (
					<details class="disc">
						<summary>The release's own runs, Decision Index 0.2.1</summary>
						<div class="disc__body">
							<p>Our own runs of the whole suite, self-run, as the evaluation card records them.</p>
							{selfRunTables.map((t) => {
								// The card's prose states how many requests were scored, so that column would repeat it.
								const keep = t.head.map((h) => !/Scored requests answered/.test(h));
								return <UpstreamTable head={t.head.filter((_, i) => keep[i])} rows={t.rows.map((r) => r.filter((_, i) => keep[i]))} caption="The Decision Index 0.2.1, whole suite, self-run per base" />;
							})}
							<p><Source record="EVAL_CARD.md" label="Source" anchor={anchor(selfRunHeading!)} /></p>
						</div>
					</details>
				)}
			</div>
		</div>
	</section>

	<section class="section psec" aria-labelledby="bases">
		<div class="wrap">
			<div class="section__head">
				<p class="kicker">Public harnesses</p>
				<h2 id="bases">Each base, <em class="hl">measured by us</em></h2>
				<p>{b.source.map((s) => <span set:html={`${s} `} />)}</p>
			</div>
			<div class="pcard tile" data-reveal>
				<div class="pcard__head">
					<h3 class="pcard__title">Accuracy and macro-F1</h3>
					<p class="pcard__meta">higher is better; each column links to its record</p>
				</div>
				<BenchmarkTable />
				<p class="pcard__foot" set:html={thirdBase} />
				<p class="pcard__foot">Calibration for each base is in the capabilities table below, under "Probabilities I can trust?". <span set:html={b.standing.card} /></p>
			</div>
		</div>
	</section>

	{b.speed.length > 0 && (
		<section class="section psec" aria-labelledby="speed">
			<div class="wrap">
				<div class="section__head">
					<p class="kicker">Server time</p>
					<h2 id="speed">How long <em class="hl">an answer takes</em></h2>
					<p>The README's server-time rows, every base on a shared scale from zero.</p>
				</div>
				<div class="pcard tile" data-reveal>
					<SpeedCharts />
					{latency.length > 0 && (
						<details class="disc">
							<summary>Where these were measured</summary>
							<div class="disc__body" data-table-notes>{latency.map((l) => <p set:html={l} />)}</div>
						</details>
					)}
				</div>
			</div>
		</section>
	)}

	<section class="section psec" aria-labelledby="paired">
		<div class="wrap">
			<div class="section__head">
				<p class="kicker">Choosing a base</p>
				<h2 id="paired">Gemma 4 12B and Qwen3.6-35B-A3B, <em class="hl">paired</em></h2>
				<p set:html={pairedIntro} />
			</div>
			<div class="pcard tile" data-reveal>
				<div class="pcard__head">
					<h3 class="pcard__title">The same items, both bases</h3>
					<p class="pcard__meta"><Source record="runs/2026-10-04_gemma-base/" /></p>
				</div>
				<UpstreamTable head={paired.head} rows={paired.rows} caption="Gemma 4 12B against Qwen3.6-35B-A3B on the same items" />
			</div>
		</div>
	</section>

	<section class="section psec" aria-labelledby="many-questions">
		<div class="wrap">
			<div class="pcard tile mq-card" data-reveal>
				<ManyQuestions chart="log" />
			</div>
		</div>
	</section>

	<section class="section psec" aria-labelledby="compares">
		<div class="wrap">
			<div class="section__head">
				<p class="kicker">How it compares</p>
				<h2 id="compares">Beside Jev and <em class="hl">three open entries</em></h2>
				<p>decisio's three bases beside TypeSafe's Jev 1.13 and three open-weights entries from the Decision Index's public board, as of 2026-10-05. Jev's and the other entries' values come only from the public boards.</p>
				<p>Our Decision Index values here are our own runs on the Decision Index 0.2.1, and the JevBench counts are this repository's records, not board entries. Decisio's rows as the board lists them, in its data file of {di.date}, are under <a href="#decision-index">the Decision Index board</a>, above.</p>
			</div>
			<HowItCompares />
		</div>
	</section>

	<section class="section psec" aria-labelledby="limits">
		<div class="wrap">
			<div class="section__head">
				<p class="kicker">Limits</p>
				<h2 id="limits">What these numbers <em class="hl">do not show</em></h2>
				<p><Source record="EVAL_CARD.md" label="The evaluation card, section 5" anchor="5-limits" /> has each limit as it was written.</p>
			</div>
			<ul class="ptiles" data-reveal>
				{limitTiles.map((l) => (
					<li class="ptile tile">
						{l.title && <h3>{l.title}</h3>}
						{l.body.map((html) => <p set:html={html} />)}
					</li>
				))}
			</ul>
			<p class="page-hero__links"><a class="chip" href="/docs/evaluation-card/">Every table, in the evaluation card</a><a class="chip" href="/docs/comparison/">How it compares, in the docs</a></p>
		</div>
	</section>
</SiteLayout>
<script>
	import '../scripts/reveal.ts';
	import '../scripts/disclose.ts';
</script>
