---
// One recorded support task, explained through teaching, certification and application routing.
// Historical comparisons are shown in sequence; the older answer-mix replay is labelled as a simulated policy.
import CertifiedWalkthrough from '../../components/CertifiedWalkthrough.astro';
import cases from '../../data/teach-certify/walkthrough.json';
import { makeWalkthrough } from '../../lib/certified-walkthrough.mjs';
import '../../styles/certified-walkthrough.css';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { site } from '../../config/site';
import { breadcrumbs } from '../../lib/jsonld.mjs';
import { drawsChart, pc, scatter, sharesChart } from '../../lib/tc-charts.mjs';
import { ALPHAS, SETUPS, baseClass, baseName, data, datasetName, oosReplay, task } from '../../lib/teach-certify.mjs';
import '../../styles/home.css';
import '../../styles/pages.css';
import '../../styles/teach-certify.css';

const d = data();
const n = (x: number) => x.toLocaleString('en-US');
const ib = d.inbox;
const START = '0.05';

// The share automated, each setup at 10 examples per intent, draw 1.
const shareRows = SETUPS.map(([b, ds]) => {
	const t = task(b, ds);
	return {
		label: [datasetName(ds), baseName(b)], base: baseClass(b),
		bars: [...ALPHAS].reverse().map((a) => ({ alpha: Number(a), share: t.certs[a]?.covered ? t.certs[a].covered / t.test_n : null, wrong: t.certs[a]?.covered ? t.certs[a].errors / t.certs[a].covered : 0 })),
	};
});
const drawRows = ['g31', 'g12'].flatMap((b) => ['0.05', '0.1'].map((a) => ({
	label: baseName(b), base: baseClass(b), alpha: Number(a),
	shares: [1, 2, 3].map((draw) => { const c = task(b, 'banking77', 10, draw).certs[a]; return c.covered / task(b, 'banking77', 10, draw).test_n; }),
})));
const gains = SETUPS.map(([b, ds]) => ({ t: task(b, ds), b, ds }));

// The re-splits: the four setups at three targets, for the script; the first view is the 31B on BANKING77 at 5%.
const resplits = Object.fromEntries(SETUPS.map(([b, ds]) => [`${b}-${ds}`, { label: `${datasetName(ds)}, ${baseName(b)}`, by: Object.fromEntries(ALPHAS.map((a) => [a, task(b, ds).resplit[a].splits])) }]));
const first = scatter({ splits: resplits['g31-banking77'].by[START], alpha: Number(START), label: resplits['g31-banking77'].label });
const c12 = task('g12', 'clinc150'), c31 = task('g31', 'clinc150');

// The drift stream, on the 31B.
const dr0 = d.drift.g31;
const fix = d.fix;
const oos = oosReplay();
const gk = d.gatekeeper;
// decisio 0.16.0's alarm and served-path certificate.
const r16 = d.release016?.released ? d.release016 : null;
if (!r16 || !fix || !gk) throw new Error('teach-and-certify: the records lack the 0.16.0 alarm, the out-of-scope fix or the gatekeeper');
const range = ([lo, hi]: number[]) => `${pc(lo, 0)} to ${pc(hi, 0)}`;
// A count that opens a sentence, or stands alone in prose, in words.
const words = (x: number) => ['no', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten', 'eleven', 'twelve'][x] ?? n(x);
const cap = (t: string) => t[0].toUpperCase() + t.slice(1);

const ds = d.datasets;
// The promise's confidence and the re-splits' count, as the page says them.
if (Math.round(1 / d.delta) !== 10) throw new Error('teach-and-certify: the certificates are no longer made at 90% confidence; the page says nine times in ten');
const splits = task('g31', 'banking77').resplit[START].splits.length;
const perHundred = (x: number) => Math.round(x * 100);
const oneIn = gk ? Math.round(gk.unsafe.certified / gk.unsafe.unsafe) : 0;

const record = makeWalkthrough(ib, cases, d.decisio);
const jump = r16.jump;
const events = [
 { title: "Matching traffic", at: "Before the change", note: "The application can use certified predictions." },
 { title: "Traffic changes", at: `Message ${n(jump.jump_at)}`, note: "A new kind of traffic starts arriving." },
 { title: "Certification pauses", at: `Message ${n(jump.first_suspended)}`, note: "Predictions continue. The application sends them for review." },
 { title: "Traffic returns", at: `Message ${n(jump.returned_at)}`, note: "The monitor needs evidence that traffic is normal again." },
 { title: "Certification resumes", at: `Message ${n(jump.returned_at + jump.resumed_after)}`, note: "The confidence alert clears and certified routing can resume." },
];
---
<SiteLayout bodyClass="home" jsonLd={breadcrumbs([{ name: 'Demos', path: '/demos/' }, { name: 'Certified answers', path: '/demos/teach-and-certify/' }])} title={`Certified answers: ${site.name}`} description="Follow one support ticket through teaching, certification and your application's routing decision. Explore recorded predictions, error targets and the review path.">

<div class="wrap">
<CertifiedWalkthrough record={record} source={`${datasetName(ib.dataset)}, ${baseName(ib.model)} FP8 on one RTX PRO 6000 Blackwell. Recorded on decisio ${d.decisio}, ${d.dates.join(', ')}, plain layout. ${ib.k} examples per intent, draw ${ib.draw}.`} />
<section class="ca-drift ca-player decision-visual" id="drift" data-player="drift" data-loop data-playback="idle" aria-labelledby="drift-title" data-table-notes>
 <div class="ca-section-head"><div><p class="ca-eyebrow">When traffic changes</p><h2 id="drift-title">Predictions continue. Certification can pause.</h2></div></div>
 <p>A separate recorded traffic stream shows the confidence alarm responding to a change in traffic. The monitor detects a shift across messages; it cannot tell whether one particular prediction is wrong.</p>
 <ol class="ca-event-list">{events.map((event, i) => <li class="ca-event" data-phase={i}><strong>{event.title}</strong><span>{event.at}</span><p>{event.note}</p></li>)}</ol>
 <p class="ca-play-status">All recorded events are shown. The repeating sequence illustrates their order, not elapsed time.</p>
 <p class="ca-drift-note">Detection takes time. In this recording, {jump.wrong_before} wrong predictions were certified before the pause. While certification is paused, your application should request review.</p>
 <p class="src-note">Recorded confidence-alarm jump stream on decisio {r16.version} release candidate, {baseName('g31')} FP8, one RTX PRO 6000 Blackwell. Event positions come from the recorded stream. They are not timings promised for new traffic.</p>
 <p data-monitor-note>Current behavior: the confidence alarm can suspend certification; an answer-mix alert only reports a change. <a href="/docs/tasks/drift/">Read how monitoring works</a>.</p>
 <details class="ca-inspect"><summary>What should I do when it pauses?</summary><p>Keep predictions as suggestions for review. If the new traffic persists, collect representative labels, include an "other" option where appropriate, then teach and certify again. If traffic returns to normal, the confidence alert can clear.</p><p>An "other" option helps the task recognise unfamiliar inputs. It does not guarantee the chosen error rate under arbitrary new traffic.</p></details>
</section>
<section class="ca-evidence-area" aria-labelledby="evidence-title"><h2 class="ca-evidence-heading" id="evidence-title">Explore the recorded evidence</h2><p>Compare tasks and models once the process is clear. These are measured recordings, not results promised for your own task.</p>
	<section class="ca-evidence" id="share" aria-labelledby="share-heading"><div class="ca-evidence-body">
		<div class="wrap">
			<div class="section__head">
				<p class="kicker">The share automated</p>
				<h2 id="share-heading">How much each rate <em class="hl">answers on its own</em></h2>
				<p>Each bar is the share of a test split the certificate covered, and how often those answers were wrong. Two intent sets, two bases, {ib.k} labelled examples per intent.</p>
			</div>
			<div class="pcard tile">
				<ul class="minis tc-gains">
					{gains.map(({ t, b, ds: set }) => <li class="mini"><span class="mini__n">{pc(t.untaught)} to {pc(t.accuracy)}</span><span class="mini__l">answered right, untaught and taught: {datasetName(set)} on {baseName(b)}</span></li>)}
				</ul>
				<div class="tc-chart" set:html={sharesChart(shareRows)} />
				<p class="tc-read">At 10% the certificate covers most of each split. At 2% {datasetName('banking77')} certifies nothing on either base: no cutoff was certified at that target in these recordings. {datasetName('clinc150')}'s intents barely overlap, so even a strict rate covers most of it.</p>
			</div>
		</div>
	</div></section>

	<section class="ca-evidence" id="promise" aria-labelledby="promise-heading"><div class="ca-evidence-body">
		<div class="wrap">
			<div class="section__head">
				<p class="kicker">The promise</p>
				<h2 id="promise-heading">{n(splits)} re-splits, <em class="hl">one line to stay under</em></h2>
				<p>A certificate promises that, nine times in ten, at most the rate picked of its certified answers are wrong. To watch that hold, each task's held-out and test answers were pooled and split again {n(splits)} times: certify on one part, count the mistakes on the other.</p>
				<p>Each dot is one split. A dot above the line is a split where the promise missed, and nine in ten is the bar.</p>
			</div>
			<div class="pcard tile tc-resplit" data-tc-resplit={JSON.stringify(resplits)}>
				<div class="tc-controls">
					<div class="tc-chips" role="group" aria-label="Setup">
						{SETUPS.map(([b, set], i) => <button class:list={['chip', baseClass(b)]} type="button" aria-pressed={String(i === 0)} data-setup={`${b}-${set}`}><span class="dot" aria-hidden="true"></span>{datasetName(set)}, {baseName(b)}</button>)}
					</div>
					<div class="tc-chips" role="group" aria-label="Error rate">
						{ALPHAS.map((a) => <button class="chip" type="button" aria-pressed={String(a === START)} data-alpha={a}>{pc(Number(a), 0)}</button>)}
					</div>
				</div>
				<div class="tc-chart tc-chart--scatter" data-tc-scatter set:html={first.svg} />
				<dl class="tc-counts" aria-live="polite">
					<div><dt>The promise held</dt><dd><b data-count="held">{first.held}</b> of {n(splits)} splits</dd></div>
					<div><dt>Over the rate</dt><dd><b data-count="over">{first.over}</b> splits</dd></div>
					<div><dt>Certified nothing</dt><dd><b data-count="nothing">{first.nothing}</b> splits, counted as held</dd></div>
				</dl>
			</div>
		</div>
	</div></section>

	<section class="ca-evidence" id="fix" aria-labelledby="fix-heading"><div class="ca-evidence-body">
		<div class="wrap">
			<div class="section__head">
				<p class="kicker">Drift</p>
				<h2 id="fix-heading">Historical out-of-scope results</h2><p class="ca-history-note">This offline replay simulated pausing certification on an answer-mix alert. In the current release, answer-mix changes only report an alert; they do not suspend certification on their own.</p>
				<p>The {datasetName('clinc150')} task was taught its {fix.options - 1} intents and no way to say a message fits none of them. A replay of {n(dr0.messages)} messages then mixed in off-topic ones, from none at message {n(dr0.start)} to {perHundred(dr0.top_share)} in every 100 by message {n(dr0.top)}, and each one certified was a wrong answer sent out.</p>
			</div>

			<div class="pcard tile tc-fix" id="historical-oos">
				<h3 class="tc-h3">An older replay with an out-of-scope option</h3>
				<p class="tc-read">Give the task one more option, out of scope, taught from {fix.oos_taught} off-topic examples, and certify it on held-out examples that include {fix.cert_oos} off-topic ones. An off-topic message then has a right answer, and the certificate counts it.</p>
				<div class="table-scroll tc-compare">
					<table class="data-table">
						<caption>The same drift stream, off-topic rising from 0 at message {n(fix.start)} to {pc(fix.top_share, 0)} at {n(fix.top)}, with suspension in that historical monitor replay.</caption>
						<thead><tr><th scope="col"></th><th scope="col">No out-of-scope option</th><th scope="col">Out of scope taught</th></tr></thead>
						<tbody>
							<tr><th scope="row">First paused answer</th><td>{n(oos.untaught.first_suspended)}</td><td>{n(oos.with_pause.first_paused_answer)}</td></tr>
							<tr><th scope="row">Right, over the whole stream</th><td>{pc(oos.rightUntaught)}</td><td>{pc(oos.rightTaught)}</td></tr>
						</tbody>
					</table>
				</div>
				<ul class="tc-promise" data-table-notes>
					<li>Without the option, the confidence alarm pauses the task sooner: at answer {n(oos.untaught.first_suspended)}, after {oos.untaught.wrong_before} wrong certified answers.</li>
					<li>With the option taught, the answer mix pauses it at answer {n(oos.with_pause.first_paused_answer)}, when about {pc(oos.shareAtPause, 0)} of the messages are off-topic. Over the stream, {pc(oos.with_pause.wrong_among_certified_whole_stream)} of its certified answers are wrong, against {pc(oos.alert_only.wrong_among_certified_whole_stream)} with an alarm that only reports, and {n(oos.with_pause.wrong_certified_from_1001_to_end)} wrong answers go out certified from message {n(fix.start + 1)} on, against {n(oos.alert_only.wrong_certified_from_1001_to_end)}.</li>
					<li>It paused on all {oos.seed_sweep.seeds} seeds of the monitor's sampling, and never on the same stream without its off-topic messages.</li>
				</ul>
				<p class="tc-read">Teaching an "other" option improved the recorded predictions. Label representative new traffic and certify again before relying on a changed distribution.</p>
				<p class="tc-src src-note">Out of scope taught: a replay of recorded readouts through the decisio {oos.decisio} monitor, {baseName('g31')} FP8 on {d.models.g31.machine.replace(/ \(.*\)$/, '')}, replayed {oos.date}; the readouts were recorded on decisio {oos.recorded_on}, on the plain layout. No out-of-scope option: the pause measured on the decisio {r16.version} release candidate.</p>
			</div>

		</div>
	</div></section>

	<section class="ca-evidence" id="gatekeeper" aria-labelledby="gatekeeper-heading"><div class="ca-evidence-body">
		<div class="wrap">
			<div class="section__head">
				<p class="kicker">Gatekeeper</p>
				<h2 id="gatekeeper-heading">Allow, ask or block, <em class="hl">for a coding agent's commands</em></h2>
				<p>A coding agent proposes a shell command, and a team has {gk.rules.length} written rules, each saying allow, ask or block. {baseName(gk.model)} was taught the rules from {gk.per_rule} labelled commands per rule and asked which rule covers each command; the action follows from the rule.</p>
			</div>
			<div class="pcard tile tc-gk">
				<ol class="gkflow" aria-label="How a command is decided">
					<li class="gkflow__s"><b>A command</b><code>rm -rf build/</code></li>
					<li class="gkflow__s"><b>Which rule covers it?</b><span>one question over the {gk.rules.length} rules</span></li>
					<li class="gkflow__s"><b>The rule's action</b><span><span class="tc-act tc-act--allow">allow</span> <span class="tc-act tc-act--ask">ask</span> <span class="tc-act tc-act--block">block</span></span></li>
					<li class="gkflow__s gkflow__s--end"><b>Certified?</b><span>yes: act on it; no: ask a person</span></li>
				</ol>
				<ul class="minis tc-gains">
					<li class="mini"><span class="mini__n">{range(gk.at5.share)}</span><span class="mini__l">of the commands decided on its own at most 5% wrong, with the wrong action in {pc(gk.at5.wrong_action[0])} to {pc(gk.at5.wrong_action[1])} of those</span></li>
					<li class="mini"><span class="mini__n">{range(gk.at10.share)}</span><span class="mini__l">decided on its own at most 10% wrong</span></li>
					<li class="mini"><span class="mini__n">{gk.unsafe.unsafe} of {n(gk.unsafe.certified)}</span><span class="mini__l">certified commands let through when the policy says ask or block, across the {words(gk.unsafe.tasks)} taught versions of the task</span></li>
				</ul>
				<p class="tc-read">That is about 1 in {oneIn}. {cap(words(gk.unsafe.model_mistakes))} were real model mistakes, such as <code>gh stack merge 7</code>; {words(gk.unsafe.policy_lists)} were strict items in the policy's own lists, commands the rule text supports, such as test runs through <code>python -m</code>. All {gk.unsafe.unsafe} count as errors, because the policy is the ground truth.</p>
				<h3 class="tc-h3">When a new kind of command arrives</h3>
				<p class="tc-read">Database and migration commands, a kind no rule names, rose to {pc(gk.drift.new_kind_share, 0)} of the traffic. None of the {gk.drift.new_kind} was certified, and {gk.drift.to_ask} went to "ask" through the policy's catch-all rule, "any other program".</p>
				<p class="tc-lesson">The lesson beside {datasetName('clinc150')}'s: a catch-all option gives unfamiliar commands a review path. {datasetName('clinc150')}'s task had none, so until the alarm paused certification, its off-topic messages went out certified as some other intent.</p>
				<section class="ca-rules" aria-labelledby="rules-heading">
					<h3 id="rules-heading">The {gk.rules.length} rules and their actions</h3>
					<div class="disc__body">
						<ul class="tc-rules">
							{gk.rules.map((r) => <li><code>{r.rule}</code> <span class:list={['tc-act', `tc-act--${r.action}`]}>{r.action}</span></li>)}
						</ul>
					</div>
				</section>
				<p class="tc-src src-note">{baseName(gk.model)}, the 6-bit MLX conversion <code>{gk.conversion}</code>, decisio {gk.decisio}, {gk.dates.join(' and ')}. Three draws of {gk.per_rule} commands per rule, each read on the same {n(gk.test_n)} test commands; one more version, taught with 10 per rule, was read across two server starts.</p>
			</div>
		</div>
	</div></section>

	<section class="ca-evidence" id="rely" aria-labelledby="rely-heading"><div class="ca-evidence-body">
		<div class="wrap">
			<div class="section__head">
				<p class="kicker">Before you rely on it</p>
				<h2 id="rely-heading">What a certificate <em class="hl">does not cover</em></h2>
			</div>
			<div class="pcard tile">
				<ul class="tc-keep">
					<li><b>Certify where you serve.</b> A certificate holds on the serving setup it was made on: one made on a Mac does not carry to a card, or the reverse.</li>
					<li><b>Certify again after upgrading decisio.</b> A certificate covers the release it was made on.</li>
					<li><b>Give it a way to say none of these.</b> A certificate holds for messages like its held-out examples, and it cannot cover an answer the task cannot give, such as out of scope.</li>
					<li><b>Which examples you teach with matters at 5%.</b> Three random draws of {ib.k} examples per intent on {datasetName('banking77')} certified very different shares of the test split at 5%; at 10% the draws agree, as the chart below shows.</li>
					<li><b>A harder test split moves the rate.</b> Both 2% certificates on {datasetName('clinc150')} came in a little over the rate on its official test split, which is harder than the validation split they were made on: there {baseName('g12')} is right {pc(c12.cal_accuracy)} of the time and {baseName('g31')} {pc(c31.cal_accuracy)}. Pooled and re-split, the same answers hold.</li>
					<li><b>Some mistakes are labels that overlap.</b> "my wallet was stolen with my cards in it" is labelled <code>compromised_card</code> and was answered <code>lost_or_stolen_card</code>. They count as mistakes here, as they would in a real inbox.</li>
					<li><b>What was not tried:</b> more than one machine per base, legal text, long documents, other languages or adversarial messages.</li>
				</ul>
				<h3 class="tc-h3">The share certified, three draws of {ib.k} examples per intent, {datasetName('banking77')}</h3>
				<div class="tc-chart" set:html={drawsChart(drawRows)} />
			</div>
		</div>
	</div></section>

	<div class="ca-credits src-note" id="method">
    <p>Dataset credits: <a href={ds.banking77.url}>BANKING77</a>: {ds.banking77.credit}. {ds.banking77.licence}.</p><p><a href={ds.clinc150.url}>CLINC150</a>: {ds.clinc150.credit}. {ds.clinc150.licence}. Test messages are unchanged.</p>
    <p>Command sources:</p>{gk.sources.map(src => <p><a href={src.url}>{src.name}</a>: {src.credit}. {src.licence}.</p>)}<p>Templated and replay database commands are CC0.</p>
  </div>

</section>
</div>
	<section class="section psec" aria-labelledby="next">
		<div class="wrap">
			<div class="section__head">
				<p class="kicker">What next</p>
				<h2 id="next">Certify <em class="hl">your own task</em></h2>
			</div>
			<p class="page-hero__links"><a class="chip" href="/docs/tasks/certify/">Certify answers</a><a class="chip" href="/docs/use-cases/support-routing/">Support routing</a><a class="chip" href="/docs/tasks/">Teach your task</a></p>
		</div>
	</section>
</SiteLayout>
<script>
 import "../../scripts/teach-certify.ts";
</script>
