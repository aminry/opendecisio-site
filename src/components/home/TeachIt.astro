---
// "Teach it", right after the hero: one task end to end, the support inbox (BANKING77 on the Gemma 4 31B). A story of
// about 15 seconds (the examples taught, the answer sharpening, the threshold drawn, the certified answers automated
// and the rest sent to a person), two counters beside it, and the three steps. Every number is inboxStory()'s
// (src/lib/home-page.mjs), read from the teach-and-certify run records; the certified shares are the threshold line's,
// in the next section, so they are stated once.
import { inboxStory } from '../../lib/home-page.mjs';
import { scene } from '../../lib/teach-scene.mjs';
const d = inboxStory();
const pct = (x: number, k = 1) => `${(x * 100).toFixed(k)}%`;
const wide = scene(d, 'wide');
const narrow = scene(d, 'narrow');
const steps = [
	{ t: 'Teach.', x: 'Send labelled examples of your question. It takes minutes, and the weights stay as they are.' },
	{ t: 'Certify.', x: 'The server holds some of your examples back and finds the confidence above which wrong answers stay under the rate you pick.' },
	{ t: 'Act.', x: 'Every answer says whether it is certified. Automate the certified ones and send the rest to a person.' },
];
---
<section class="section teach" id="teach" aria-labelledby="teach-h" data-launch="teach">
	<div class="wrap">
		<div class="section__head">
			<p class="kicker">Teach it</p>
			<h2 id="teach-h">Teach it your labels. <em class="hl">It tells you which answers to trust.</em></h2>
			<p>A support inbox with {d.learn.labels} kinds of request: the server learns what each label means from a few examples, then marks every answer it is sure of. The model's weights never change.</p>
		</div>

		<div class="teach__stage tile" data-teach>
			<div class="teach__bar">
				<ol class="teach__acts" aria-label="The story">
					<li data-act="0"><b>1</b> Learn your labels</li>
					<li data-act="1"><b>2</b> Draw the line</li>
					<li data-act="2"><b>3</b> Route the answers</li>
				</ol>
				<button type="button" class="chip teach__play" data-teach-play hidden>Pause</button>
			</div>
			<div class="teach__svgs">
				<Fragment set:html={wide.svg} />
				<Fragment set:html={narrow.svg} />
			</div>
			<dl class="teach__counters">
				<div class="teach__c">
					<dt>Right answers, untaught and taught</dt>
					<dd><span class="teach__before">{pct(d.learn.before)}</span> to <b data-teach-count={(d.learn.after * 100).toFixed(1)} data-from={(d.learn.before * 100).toFixed(1)}>{pct(d.learn.after)}</b></dd>
				</div>
				<div class="teach__c">
					<dt>Taught with</dt>
					<dd><b>{d.learn.examples.toLocaleString('en-US')} examples</b> <span>{d.learn.perLabel} for each label</span></dd>
				</div>
			</dl>
			<p class="teach__src">The dots are {d.certify.n} of its answers, a seeded random sample, split by the certificate at most {pct(d.certify.alpha, 0)} wrong.</p>
			<p class="teach__src src-note">{d.source}.</p>
		</div>

		<ol class="teach__how" aria-label="How it works">
			{steps.map((s, i) => (
				<li class="teach__step tile">
					<span class="teach__n" aria-hidden="true">{i + 1}</span>
					<h3>{s.t}</h3>
					<p>{s.x}</p>
				</li>
			))}
		</ol>
		<div class="actions teach__cta"><a class="button button--primary" href="/docs/tasks/">Teach a task</a><a class="button" href="/docs/use-cases/support-routing/">The support-routing recipe</a></div>
	</div>
</section>
<script>
	import '../../scripts/teach.ts';
</script>
