---
// The live demo in the hero: a picker of recorded decisions (the first records of four decisio-examples runs, taken as
// they came, from figures.recorded_decisions, each sent again to decisio 0.17.0: src/lib/recorded.mjs), each played as the flow it is: the text enters, the server reads it once,
// and then scores the request's questions together in one batch, as the Gemma 4 31B does by default (`--multi-question
// warm`, decisio's docs/cli.md), so every bar fills at once. The probabilities and the server time are the 0.17.0 replay's; the
// time is shown as one total for the request, read and batch together. The first record is in the page as its final state, so the panel is the same size
// before and after the script runs (no layout shift) and shows a real decision without it; the picker and the replay
// buttons appear with the script. Labelled with the base, the version and the box the records came from; "See the request"
// goes to the request and its answer under Get started.
import { recordedExamples } from '../../lib/launch.mjs';
const d = recordedExamples();
const first = d.items[0];
const groups: Record<string, number[]> = {};
d.items.forEach((it, i) => (groups[it.kind] ??= []).push(i));
// A score keeps its scale order and shows every level; a choice is sorted by probability: the top three, then a count of the rest.
const ranked = (q: any) => [...q.bars].sort((x: any, y: any) => y.p - x.p);
const shown = (q: any) => (q.type === 'score' ? q.bars : ranked(q).slice(0, 3));
const hidden = (q: any) => (q.type === 'score' ? [] : ranked(q).slice(3));
---
<div class="demo glass" data-demo data-items={JSON.stringify(d.items)}>
	<div class="demo__head">
		<span class="demo__live"><i aria-hidden="true"></i> recorded</span>
		<span class="demo__meta" data-demo-meta>{d.boxLabel}</span>
	</div>
	<div class="demo__pick" data-demo-pick role="group" aria-label="Recorded decisions">
		{Object.entries(groups).map(([kind, idx]) => (
			<span class="pick__grp"><span class="pick__k">{kind}</span>{idx.map((i, n) => <button type="button" class="chip" data-i={i} aria-pressed={i === 0 ? 'true' : 'false'} aria-label={`${kind} ${n + 1}`}>{n + 1}</button>)}</span>
		))}
	</div>
	<div class="demo__body" data-demo-body>
		<div class="demo__in"><p class="demo__tag" data-demo-kind>Incoming {first.kind.toLowerCase()} · record {first.record} of {first.of.toLocaleString('en-US')}</p><p class="demo__state" data-demo-state>{first.state}</p></div>
		<p class="demo__read"><span class="demo__pill"><i aria-hidden="true"></i><b>reads it once</b><span>then scores every question in one batch</span></span></p>
		<div class="demo__qs" data-demo-qs>
			<span class="demo__spine" aria-hidden="true"></span>
			{first.questions.map((q) => (
				<div class="dq"><span class="dq__branch" aria-hidden="true"></span><p class="dq__head"><b>{q.name}</b><span>{q.type}</span>{q.result && <span class="dq__res">{q.result}</span>}</p><p class="dq__ask">{q.ask}</p>
					<ul class="dq__bars">
						{shown(q).map((b) => <li class:list={['dq__bar', { 'is-top': b.top }]}><span title={b.title ?? ''}>{b.label}</span><span class="dq__rail"><span class="dq__fill" style={`width:${Math.max(b.p * 100, 1)}%`}></span></span><span class="dq__p">{b.p.toFixed(2)}</span></li>)}
						{hidden(q).length > 0 && <li class="dq__more" title={hidden(q).map((b) => `${b.label} ${b.p.toFixed(2)}`).join(', ')}>+{hidden(q).length} more</li>}
					</ul>
				</div>
			))}
		</div>
		<div class="demo__foot">
			<p class="demo__count" data-demo-count aria-live="polite">{first.questions.length} answers in one batch · {first.serverMs.toFixed(1)} ms server time</p>
			<p class="demo__ctl"><button type="button" class="chip" data-demo-play="1">Replay at recorded speed</button> <button type="button" class="chip" data-demo-play="30">Slowed down</button></p>
			<p class="demo__req"><a href="#ask">See the request and its answer</a></p>
		</div>
	</div>
</div>
