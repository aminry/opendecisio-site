---
// "Why Decisio": the three lines of the decisio README's block that the proof cards above do not already say, each made
// only if launch_facts.public.json says it (whyDecisio in src/lib/launch.mjs), each with a larger graphic that draws when the card
// scrolls into view.
import { recordedExamples, whyDecisio } from '../../lib/launch.mjs';
import WhyIcon from './WhyIcon.astro';

// The proof cards say the intelligence and the sealed-set lines (the first two), so they are not repeated here.
const items = whyDecisio().slice(2);
// The first graphic's bars: the top probability of each question of the first recorded decision.
const first = recordedExamples().items[0];
const bars = first.questions.map((q) => Math.max(...q.bars.map((b) => b.p)));
---
<section class="section why" aria-labelledby="why-decisio" data-launch="why-decisio">
	<div class="wrap">
		<p class="kicker">Why</p>
		<h2 id="why-decisio" class="why__title">Why <em class="hl">Decisio</em></h2>
		<ul class="why__list" data-reveal>
			{items.map((i, k) => (
				<li class="why__item tile tilt">
					<WhyIcon kind={k} bars={bars} />
					<h3 class="why__head">{i.title}</h3>
					<p class="why__text">{i.text}{i.quote && <> <span data-quote><a href={i.quote.url}>"{i.quote.text}"</a></span></>}</p>
				</li>
			))}
		</ul>
	</div>
</section>
