---
// A code block of the home page whose long lines wrap with a hanging indent:
// each line is its own block, so a wrapped line continues two characters in from
// where the line's text starts and reads as one line. The text is the block's
// text, line for line; there is no script.
interface Props { text: string; label: string; }
const { text, label } = Astro.props;
const lines = text.split('\n').map((line) => ({ line: line === '' ? ' ' : line, hang: (line.match(/^ */)?.[0].length ?? 0) + 2 }));
---
<pre class="code" aria-label={label}><code>{lines.map(({ line, hang }) => <span class="cl" style={`--hang: ${hang}ch`}>{line}</span>)}</code></pre>
