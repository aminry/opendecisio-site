---
// The README's recorded example response, drawn as the distributions it holds.
import { firstRequest, requestBody } from '../../lib/home.mjs';
const { response } = firstRequest();
const { questions } = requestBody();
const two = (p: number) => p.toFixed(2);
const rows = Object.entries(response).map(([name, answer]: [string, any]) => {
	const q = questions[name];
	if (answer.type === 'noul') {
		return { name, type: 'yes/no', bars: [{ label: 'yes', p: answer.noul, top: true }] };
	}
	const probs = Object.entries(answer.probabilities as Record<string, number>);
	const levels = answer.type === 'score' ? (q.criteria as string[]) : null;
	return {
		name,
		type: answer.type,
		bars: probs.map(([key, p]) => ({
			label: levels ? `${key}` : key,
			title: levels ? levels[Number(key)] : (q.criteria[key] ?? key),
			p,
			top: answer.type === 'choice' ? key === answer.choice : String(Math.round(answer.score)) === key,
		})),
		result: answer.type === 'choice' ? answer.choice : answer.type === 'score' ? `level ${answer.score.toFixed(1)}` : undefined,
	};
});
const { class: className = '' } = Astro.props;
---
<figure class:list={['answer', className]} aria-label="The example response">
	{rows.map((row) => (
		<div class="answer__q">
			<p class="answer__head"><code>{row.name}</code><span class="answer__type">{row.type}</span>{row.result && <span class="answer__result">{row.result}</span>}</p>
			<ul class="answer__bars">
				{row.bars.map((b) => (
					<li class:list={['answer__bar', { 'is-top': b.top }]}>
						<span class="answer__label" title={b.title}>{b.label}</span>
						<svg class="answer__track" viewBox="0 0 100 6" preserveAspectRatio="none" aria-hidden="true"><rect class="answer__rail" width="100" height="6"></rect><rect class="answer__fill" width={Math.max(b.p * 100, 0.6)} height="6"></rect></svg>
						<span class="answer__p">{two(b.p)}</span>
					</li>
				))}
			</ul>
		</div>
	))}
	<slot />
</figure>
