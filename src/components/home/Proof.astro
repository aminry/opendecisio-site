---
// On the board: the home page's one comparison with another system, the JevBench composite of Decisio 31B and Jev
// 1.13.0 on the board's v1.6.1 file, in the launch facts' stable claim (composite_v161) with its date and source, and
// drawn as the two intervals. Every other comparison is on the benchmarks page, dated.
import { BOARD_URL, jevbench, refuse, stable } from '../../lib/launch.mjs';
const c = stable('composite_v161');
const v = (x: any) => Number(x.value ?? x);
const rows = [
	{ name: 'Decisio 31B', cls: 'pr-ours', at: v(c.values.ours), ci: c.values.ours_interval.value as number[] },
	{ name: 'Jev 1.13.0', cls: 'pr-jev', at: v(c.values.theirs), ci: c.values.theirs_interval.value as number[] },
];
const read = /^(\d{4}-\d{2}-\d{2})/.exec(c.date)?.[1];
if (!read) throw new Error('Proof: stable_claims.composite_v161 has no date');
// The axis: whole points around both intervals.
const lo = Math.floor(Math.min(...rows.map((r) => r.ci[0]))) - 1;
const hi = Math.ceil(Math.max(...rows.map((r) => r.ci[1]))) + 1;
const W = 640;
const X0 = 150;
const X1 = 610;
const x = (s: number) => X0 + ((s - lo) / (hi - lo)) * (X1 - X0);
const ticks = Array.from({ length: hi - lo + 1 }, (_, i) => lo + i);
const desc = rows.map((r) => `${r.name}: ${r.at.toFixed(2)}, 95% interval ${r.ci[0].toFixed(2)} to ${r.ci[1].toFixed(2)}`).join('; ');
const row = jevbench().ours.display.match(/decisio (v[\d.]+)/)?.[1];
if (!row) throw new Error("Proof: the board's 31B row no longer names its decisio release");
const source = `Source: the JevBench board's v1.6.1 file, read on ${read}; its Decisio 31B row is decisio ${row}.`;
refuse(desc);
refuse(source);
---
<section class="section" id="board" aria-labelledby="board-h">
	<div class="wrap">
		<div class="section__head">
			<p class="kicker">On the board</p>
			<h2 id="board-h">What the <em class="hl">public board</em> says</h2>
		</div>
		<div class="proof tile">
			<figure class="proof__fig">
				<svg class="pr" viewBox={`0 0 ${W} 150`} role="img" aria-labelledby="pr-t pr-d" xmlns="http://www.w3.org/2000/svg">
					<title id="pr-t">JevBench v1.6.1 composite, with 95% intervals</title>
					<desc id="pr-d">{desc}.</desc>
					<g class="pr-grid">{ticks.map((t) => <g><line x1={x(t)} x2={x(t)} y1="18" y2="112" /><text x={x(t)} y="134" text-anchor="middle">{t}</text></g>)}</g>
					{rows.map((r, i) => (
						<g class={r.cls}>
							<text class="pr-l" x="0" y={46 + i * 44}>{r.name}</text>
							<line class="pr-ci" x1={x(r.ci[0])} x2={x(r.ci[1])} y1={41 + i * 44} y2={41 + i * 44} />
							<circle class="pr-dot" cx={x(r.at)} cy={41 + i * 44} r="7" />
						</g>
					))}
				</svg>
			</figure>
			<div class="proof__text">
				<p class="board__claim" data-launch="lead">{c.text}</p>
				<p class="proof__src src-note">{source}</p>
				<p class="proof__src"><a href={BOARD_URL}>The live board</a> has today's standings, and <a href="/benchmarks/#jevbench">Benchmarks</a> has what was measured and how.</p>
			</div>
		</div>
	</div>
</section>
