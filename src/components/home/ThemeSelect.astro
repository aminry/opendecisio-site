---
// The theme choice on the site's own pages, stored under Starlight's key with
// Starlight's values, so a choice made here holds in the docs and back.
---
<label class="theme">
	<span class="sr-only">Theme</span>
	<select class="theme__select" data-theme-select>
		<option value="auto">Auto</option>
		<option value="light">Light</option>
		<option value="dark">Dark</option>
	</select>
</label>
