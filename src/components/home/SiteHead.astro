---
// The <head> of the site's own pages: meta, canonical, Open Graph and Twitter
// cards, structured data, and the theme set before first paint.
import { Font } from 'astro:assets';
import { site } from '../../config/site';
import { socialImage } from '../../lib/social.mjs';
import Analytics from '../Analytics.astro';
interface Props { title: string; description: string; jsonLd?: object | object[]; canonical?: string; ogType?: 'website' | 'article'; }
const { title, description, jsonLd, canonical: canonicalOverride, ogType = 'website' } = Astro.props;
// A piece first published elsewhere points its canonical link at the original; every other page at itself.
const here = new URL(Astro.url.pathname, site.url).href;
const canonical = canonicalOverride ?? here;
const social = socialImage();
const image = social?.url;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={`${site.name} news`} href="/news/rss.xml" />
<link rel="alternate" type="application/rss+xml" title={`${site.name} articles`} href="/articles/rss.xml" />
<Font cssVariable="--font-geist" preload />
<Font cssVariable="--font-geist-mono" preload />
<meta name="color-scheme" content="light dark" />
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={here} />
{image && <meta property="og:image" content={image} />}
{image && <meta property="og:image:width" content={social.width} />}
{image && <meta property="og:image:height" content={social.height} />}
<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
{[jsonLd].flat().filter(Boolean).map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
<script is:inline>
	(() => {
		document.documentElement.classList.add('js');
		const stored = localStorage.getItem('starlight-theme');
		document.documentElement.dataset.theme = stored === 'light' || stored === 'dark' ? stored : matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
	})();
</script>
<Analytics />
