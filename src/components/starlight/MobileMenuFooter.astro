---
// The mobile menu's footer: the site's main navigation and the theme choice.
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import { currentHref, nav } from '../../config/nav.mjs';
const current = currentHref(Astro.url.pathname);
---
<div class="mobile-footer">
	<ul class="mobile-nav">
		{nav.map((l) => <li><a href={l.href} aria-current={l.href === current ? 'page' : undefined}>{l.label}</a></li>)}
	</ul>
	<ThemeSelect />
</div>

<style>
	@layer starlight.core {
		.mobile-footer {
			display: grid;
			gap: 1rem;
			border-top: 1px solid var(--sl-color-gray-6);
			padding-top: 1rem;
		}
		.mobile-nav {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 0 1.25rem;
			margin: 0;
			padding: 0;
			list-style: none;
		}
		.mobile-nav a {
			display: flex;
			align-items: center;
			min-height: 44px;
			color: var(--sl-color-gray-2);
			text-decoration: none;
			white-space: nowrap;
		}
	}
</style>
<style>
	/* The page's own section: plain, without the highlight box Starlight's sidebar styles give a current link. Outside the
	   layer above, so it wins over those styles. */
	.mobile-footer .mobile-nav a[aria-current='page'] {
		padding: 0;
		border: 0;
		box-shadow: none;
		background: none;
		color: var(--sl-color-white);
		font-weight: 600;
		text-decoration: underline;
		text-underline-offset: 5px;
	}
</style>
