---
// "Axis by axis" on the benchmarks page: the board's axes for ten open-weights systems from its file and Jev, in
// alphabetical order (axesFigure in src/lib/launch.mjs, from launch_facts.public.json's figures.axes_table). The measured
// values in the facts' stable wording, the open and sealed items as a chart, and every number in a table that starts
// closed, with a line on what each axis measures. No rank (decided 2026-10-15).
import SealedOpenChart from './SealedOpenChart.astro';
import { axesFigure } from '../lib/launch.mjs';

const a = axesFigure();
---
<div class="axes pcard tile" data-launch="axes">
	<div class="pcard__head">
		<h3 class="pcard__title" id="axis-by-axis">Axis by axis</h3>
		<p class="pcard__meta">ten open-weights systems in alphabetical order and Jev 1.13.0; higher is better on every axis</p>
	</div>
	<ul class="axes__bullets" data-table-notes>
		{a.bullets.map((b) => <li>{b}</li>)}
	</ul>
	<div data-table-notes><SealedOpenChart /></div>
	<details class="axes__all disc">
		<summary>Every number, and what each axis measures</summary>
		<ul class="axes__meaning" data-table-notes>
			{a.columns.map((c) => <li><b>{c.name}</b>: {c.tagline}</li>)}
		</ul>
		<div class="table-scroll">
			<table class="data-table data-table--stack">
				<caption class="sr-only">JevBench: ten open-weights systems and Jev 1.13.0 on the composite, the four axes and the sealed questions, with each value in its column</caption>
				<thead>
					<tr>
						<th scope="col">System</th>
						{a.columns.map((c) => <th scope="col" class="num">{c.name}</th>)}
					</tr>
				</thead>
				<tbody>
					{a.rows.map((r) => (
						<tr class:list={{ 'row--ours': r.ours }}>
							<th scope="row">{r.label}</th>
							{r.cells.map((c, i) => <td class="num" data-label={a.columns[i].name}><span>{c.text}</span></td>)}
						</tr>
					))}
				</tbody>
			</table>
		</div>
		<p class="mt-3 small muted" data-table-notes>The axes have no published intervals; the composite's is in the chart above. Source: the board's file for revision v1.6.1; its rows for decisio are v0.8.0.</p>
	</details>
</div>
