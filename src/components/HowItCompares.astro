---
// "How Decisio compares" on the benchmarks page, from docs/comparison.md at the pinned release, on the one page of the
// site where Jev and the other entries appear: the capabilities first, as the questions a buyer asks, then the headline
// (its lettered notes in a disclosure), and every index benchmark by area, each area a disclosure. Values and intervals
// with their date, no marks and no rank (decided 2026-10-15). The hosted chat models on an older JevBench revision are
// left out: they are not decision models.
import { comparison } from '../lib/comparison.mjs';
import BuyerTable from './BuyerTable.astro';
import CompareTable from './CompareTable.astro';
import HeadlineTables from './HeadlineTables.astro';
import IndexChart from './IndexChart.astro';
import Source from './Source.astro';
const c = comparison()!;
const groups = c.groups.filter((g) => !/^Hosted/i.test(g.title));
---
<div class="compares">
	<div class="pcard tile">
		<div class="pcard__head">
			<h3 class="pcard__title" id="compares-capabilities">What you get</h3>
			<p class="pcard__meta">decisio from its documentation; Jev 1.13 from TypeSafe's public documentation, read 2026-10-05</p>
		</div>
		<BuyerTable />
	</div>

	<div class="pcard tile">
		<div class="pcard__head">
			<h3 class="pcard__title" id="compares-headline">The headline</h3>
			<p class="pcard__meta">as of 2026-10-05; each cell a value with its 95% interval where there is one</p>
		</div>
		<IndexChart />
		<HeadlineTables />
	</div>

	<div class="pcard tile">
		<div class="pcard__head">
			<h3 class="pcard__title" id="compares-every">Every index benchmark</h3>
			<p class="pcard__meta">one row per benchmark, by area, as of 2026-10-05</p>
		</div>
		<details class="disc">
			<summary>Every benchmark, by area <span class="disc__n">{groups.reduce((n, g) => n + g.table!.rows.length, 0)} rows</span></summary>
			<div class="disc__body">
				<div data-table-notes>{c.everyIntro.map((p) => <p set:html={p} />)}</div>
				<p>These are the values the index counts, so a few differ from the base table above: within 0.001 on the 12B, except GPQA Diamond (two of 196 items).</p>
				{groups.map((g) => (
					<>
						<h4 class="compares__area">{g.title}</h4>
						{g.intro.map((p) => <p set:html={p} />)}
						<CompareTable head={g.table!.head} rows={g.table!.rows} caption={g.title} />
					</>
				))}
			</div>
		</details>
		<p class="pcard__foot">Each value and interval is in <Source record="runs/2026-10-05_comparison/" label="runs/2026-10-05_comparison/" />; Jev's values are the board's, as <a href="/docs/evaluation-card/#81-where-jev-leads">the evaluation card, section 8.1</a>, reads them. No figure here comes from a call of ours to TypeSafe's API.</p>
	</div>
</div>
