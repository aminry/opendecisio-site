---
// The benchmarks page's JevBench section: the public board's reading of decisio, from launch_facts.public.json
// (src/lib/launch.mjs), in the facts' stable wording with the file's date and no rank (decided 2026-10-15). What the
// board measures, the composite claim and the overlap said once, the composite chart with every row in a disclosure,
// then the axes card (the sealed items, the axes and every number).
import AxisByAxis from './AxisByAxis.astro';
import JevbenchChart from './home/JevbenchChart.astro';
import { BOARD_URL, jevbench, refuse, stable } from '../lib/launch.mjs';

const j = jevbench();
const prose = (names: string[]) => names.join(', ').replace(/, ([^,]*)$/, ' and $1');
const composite = stable('composite_v161');
const read = /^(\d{4}-\d{2}-\d{2})/.exec(composite.date)?.[1];
if (!read) throw new Error('JevbenchSection: stable_claims.composite_v161 has no date');
const claims: string[] = [composite.text, `Decisio's 95% interval on the composite overlaps those of ${prose(j.overlaps)}, so these scores cannot be separated.`];
claims.forEach(refuse);
const file = `JevBench ${j.revision}, the board's file, read ${read}`;
---
<section class="section psec" aria-labelledby="jevbench" data-launch="section">
	<div class="wrap">
		<div class="section__head">
			<p class="kicker">Public boards</p>
			<h2 id="jevbench">The JevBench <em class="hl">board</em></h2>
			<p>JevBench is an outside board that sends decision questions to each system and scores its answers on intelligence (right answers, on open questions and on sealed ones it never published), calibration, speed and cost, and on a composite of them. Its 31B row is decisio v0.8.0 on Gemma 4 31B, an earlier release of the same model; systems are in alphabetical order, and <a href={BOARD_URL}>the live board</a> has today's standings.</p>
		</div>
		<ul class="plain-list jb__claims" data-claims data-table-notes>
			{claims.map((t) => <li>{t}</li>)}
		</ul>

		<div class="pcard tile pchart">
			<div class="pcard__head">
				<h3 class="pcard__title">The composite, with its 95% interval</h3>
				<p class="pcard__meta">{file}</p>
			</div>
			<JevbenchChart />
			<p class="pcard__foot">The 12B rows' intervals are wide on the low side. Our temperatures were not fitted on JevBench, but we have read its published items (<a href="/docs/evaluation-card/#74-what-was-fitted-on-what">the evaluation card</a>, section 7.4).</p>
		</div>

		<AxisByAxis />
	</div>
</section>
