---
// Server time per base on one shared scale from zero, drawn as a dot on a
// line rather than a bar, so it reads as lower is better, and labelled so.
// Positions are SVG percentages, so the page needs no inline styles.
import { baseOfName, colourOf } from '../config/bases.mjs';
interface Row { name: string; value: string; }
interface Props { title: string; rows: Row[]; }
const { title, rows } = Astro.props;
const ms = (v: string) => Number(v.replace(/<[^>]+>/g, '').replace(/[^\d.]/g, ''));
const max = Math.max(...rows.map((r) => ms(r.value)));
const step = [5, 10, 20, 25, 50, 100, 200, 250, 500].find((s) => max / s <= 5) ?? 1000;
const top = Math.ceil(max / step) * step;
const ticks = Array.from({ length: top / step + 1 }, (_, i) => i * step);
const pct = (v: number) => `${((v / top) * 100).toFixed(2)}%`;
---
<figure class="time">
	<figcaption class="time__title"><span set:html={title} /> <span class="time__how">Server time in ms. Lower is better.</span></figcaption>
	<table class="time__table">
		<thead class="sr-only"><tr><th scope="col">Base</th><th scope="col">Server time</th></tr></thead>
		<tbody>
			{rows.map((r) => {
				const base = baseOfName(r.name);
				return (
					<tr class:list={['time__row', base && colourOf(base)]}>
						<th scope="row"><span class="dot" aria-hidden="true"></span><span set:html={r.name} /></th>
						<td class="time__plot" aria-hidden="true">
							<svg class="time__svg" width="100%" height="16" role="presentation">
								<line class="time__rail" x1="0" y1="8" x2="100%" y2="8"></line>
								<circle class="time__mark" cx={pct(ms(r.value))} cy="8" r="6"></circle>
							</svg>
						</td>
						<td class="time__value" set:html={r.value} />
					</tr>
				);
			})}
			<tr class="time__axisrow" aria-hidden="true">
				<td></td>
				<td>
					<svg class="time__svg" width="100%" height="18" role="presentation">
						{ticks.map((t, i) => <text x={pct(t)} y="13" text-anchor={i === 0 ? 'start' : i === ticks.length - 1 ? 'end' : 'middle'}>{t}</text>)}
					</svg>
				</td>
				<td></td>
			</tr>
		</tbody>
	</table>
	<slot />
</figure>
