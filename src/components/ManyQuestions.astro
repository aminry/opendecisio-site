---
// "Many questions about one document" on the benchmarks page: the same-session chart (five systems on one box, light
// and dark) and the sentences launch_facts.public.json's figures.same_box_speed allows (manyQuestions in
// src/lib/launch.mjs), with what they rest on beside them and the one line a reader sizing a server needs.
import LaunchImage from './LaunchImage.astro';
import { manyQuestions } from '../lib/launch.mjs';

const q = manyQuestions('linear');
---
<div class="mq" data-launch="many-questions" data-chart="linear">
	<div class="section__head">
		<p class="kicker">Speed</p>
		<h2 id="many-questions">Many questions about one document</h2>
		{q.sentences.map((t) => <p data-fact>{t}</p>)}
	</div>
	<figure class="lc-fig">
		<LaunchImage name={q.chart.name} width={1240} height={1120} alt={q.chart.alt} />
	</figure>
	<p class="axes__note">Measured by us. {q.qualifiers.join(" ")} {q.release}</p>
	<p class="axes__note">Each time is one request at a time; <a href="/docs/scale/">Scale</a> says how many a card serves at once.</p>
</div>
