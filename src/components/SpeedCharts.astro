---
// The README's server-time rows, one chart each, every base on a shared scale
// from zero, with the records the values come from.
import { baseOfName } from '../config/bases.mjs';
import { benchmarkRecords, benchmarks } from '../lib/home.mjs';
import Source from './Source.astro';
import TimeScale from './TimeScale.astro';

const b = benchmarks();
const records = benchmarkRecords();
const strip = (html: string) => html.replace(/<[^>]+>/g, '').replace(/ \(default\)$/, '');
const columns = b.head.slice(1).map((h) => ({ name: strip(h), record: records[baseOfName(h) as keyof typeof records] }));
const sources = [...new Set(columns.map((c) => c.record))].map((record) => ({
	record,
	bases: columns.filter((c) => c.record === record).map((c) => c.name).join(', '),
}));
---
<div class="times">
	{b.speed.map((row) => (
		<TimeScale title={row[0].replace(/, server time$/, '')} rows={row.slice(1).map((value, i) => ({ name: columns[i].name, value }))}>
			<p>{sources.map((s) => <Source record={s.record} label={s.bases} />)}</p>
		</TimeScale>
	))}
</div>
